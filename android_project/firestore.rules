rules_version = '2';

// Family Finance Tracker — Firestore Security Rules
// Priority: Security > correctness > simplicity > features
//
// Key ideas:
//   * Every doc that belongs to a family carries `familyId`.
//   * The `families/{familyId}` doc stores `memberIds[]` (denormalised) so
//     membership can be verified in a single `get()` (O(1), one extra read).
//   * Role checks read `familyMembers/{userId_familyId}` where the doc ID is
//     `"{userId}_{familyId}"` (deterministic). This avoids scans.
//   * All mutations are validated: required fields, types, ranges, and that
//     the caller belongs to the targeted family.
//
// Deploy:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function isMemberOf(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && uid() in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    function roleIn(familyId) {
      // Deterministic membership doc id: "{uid}_{familyId}"
      let memberDocId = uid() + "_" + familyId;
      return get(/databases/$(database)/documents/familyMembers/$(memberDocId)).data.role;
    }

    function isAdminOf(familyId) {
      let memberDocId = uid() + "_" + familyId;
      return isSignedIn()
        && exists(/databases/$(database)/documents/familyMembers/$(memberDocId))
        && get(/databases/$(database)/documents/familyMembers/$(memberDocId)).data.role == "admin";
    }

    function isValidString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    // ---------- users ----------
    match /users/{userId} {
      // Any authenticated user can read another user's minimal profile
      // (first name / last name) so the Family screen can display human names
      // instead of uids. Only the owner can write.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.uid == userId
        && isValidString(request.resource.data.email, 320)
        && request.resource.data.email is string;
      allow update: if isSignedIn()
        && uid() == userId
        // uid must not change
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // ---------- families ----------
    match /families/{familyId} {
      allow read: if isMemberOf(familyId);

      // Any authenticated user can create a family; creator must include self in memberIds
      // and mark themselves the creator.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == uid()
        && isValidString(request.resource.data.name, 80)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && uid() in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50;

        // Two-path update:
      //   * Admin: may rename and add/remove members.
      //   * Admin-driven self-add (via approve flow): admins already covered by first path.
      //
      // NOTE: We intentionally REMOVED the "any user can self-join" branch that existed
      // in an earlier version. New members are now added only by an admin on approval,
      // which keeps the family closed to unrequested joins even if a code leaks.
      allow update: if isSignedIn()
        && isMemberOf(familyId)
        && isAdminOf(familyId)
        && request.resource.data.createdBy == resource.data.createdBy
        && isValidString(request.resource.data.name, 80)
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 50;

      allow delete: if isAdminOf(familyId) && resource.data.createdBy == uid();
    }

    // ---------- familyMembers ----------
    // Doc id convention: "{userId}_{familyId}"
    match /familyMembers/{memberId} {
      allow read: if isSignedIn() && (
        resource.data.userId == uid() || isMemberOf(resource.data.familyId)
      );

      // Creation paths:
      //  (a) Family creator seeding themselves as admin when creating a family.
      //  (b) Admin inviting/adding a member.
      //  (c) A user accepting an invitation (adds self as "member").
      allow create: if isSignedIn()
        && memberId == request.resource.data.userId + "_" + request.resource.data.familyId
        && request.resource.data.role in ["admin", "member"]
        && (
          // (a) + (c): user adds themselves
          (request.resource.data.userId == uid())
          // (b): admin adds someone else
          || isAdminOf(request.resource.data.familyId)
        );

      // Only admins can change roles. Cannot demote the last admin.
      allow update: if isAdminOf(resource.data.familyId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.role in ["admin", "member"];

      // Admin can remove any member; a user can remove themselves.
      allow delete: if isSignedIn() && (
        isAdminOf(resource.data.familyId) || resource.data.userId == uid()
      );
    }

    // ---------- invitations ----------
    // Doc ID convention: the 6-digit numeric invitation CODE (e.g. "482193").
    // State machine:
    //   pending   → admin created; no one has used the code yet.
    //   requested → a signed-in user entered the code (they recorded their uid).
    //   accepted  → admin approved the request; user is now in the family.
    //   cancelled → admin rejected / cancelled.
    //
    // The ACTUAL family membership change happens on the admin-approval step,
    // NOT when the user submits the request. So a user merely entering the code
    // never grants access on their own — admin must confirm.
    match /invitations/{code} {
      allow get:  if isSignedIn();
      allow list: if isSignedIn() && isAdminOf(resource.data.familyId);

      allow create: if isSignedIn()
        && code.matches('^[0-9]{6}$')
        && isAdminOf(request.resource.data.familyId)
        && request.resource.data.code == code
        && request.resource.data.familyId is string
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.status == "pending";

      allow update: if isSignedIn() && (
        // Admin path: approve, reject, re-issue status. Cannot mutate code/familyId/email.
        (
          isAdminOf(resource.data.familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.email == resource.data.email
          && request.resource.data.code == resource.data.code
          && request.resource.data.status in ["pending", "requested", "accepted", "cancelled"]
        ) ||
        // User path: submit a request. Pending → requested, record requesterUserId = self.
        (
          resource.data.status == "pending"
          && request.resource.data.status == "requested"
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.email == resource.data.email
          && request.resource.data.code == resource.data.code
          && request.resource.data.requesterUserId == uid()
        )
      );

      allow delete: if isAdminOf(resource.data.familyId);
    }

    // ---------- categories ----------
    match /categories/{categoryId} {
      allow read: if isMemberOf(resource.data.familyId);

      // Only admins can create/update/delete categories.
      allow create: if isAdminOf(request.resource.data.familyId)
        && isValidString(request.resource.data.name, 40)
        && request.resource.data.familyId is string;

      allow update: if isAdminOf(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && isValidString(request.resource.data.name, 40);

      allow delete: if isAdminOf(resource.data.familyId);
    }

    // ---------- transactions ----------
    match /transactions/{txId} {
      allow read: if isMemberOf(resource.data.familyId);

      // Any family member can create a transaction for themselves.
      allow create: if isSignedIn()
        && isMemberOf(request.resource.data.familyId)
        && request.resource.data.userId == uid()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ["income", "expense"]
        && request.resource.data.categoryId is string
        && request.resource.data.recurrence in ["none", "monthly"]
        && request.resource.data.date is timestamp
        && request.resource.data.createdAt is timestamp;

      // Updates:
      //   * Owner or admin: can change anything (amount, type, category, date, recurrence, paid).
      //   * Any family member: may toggle ONLY the `paid` field (everything else unchanged).
      allow update: if isSignedIn()
        && isMemberOf(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.amount > 0
        && request.resource.data.type in ["income", "expense"]
        && (
          // Owner or admin: full edit rights.
          (resource.data.userId == uid() || isAdminOf(resource.data.familyId))
          ||
          // Any other member: only `paid` may differ.
          (
            request.resource.data.amount == resource.data.amount
            && request.resource.data.type == resource.data.type
            && request.resource.data.categoryId == resource.data.categoryId
            && request.resource.data.date == resource.data.date
            && request.resource.data.recurrence == resource.data.recurrence
          )
        );

      allow delete: if isSignedIn()
        && isMemberOf(resource.data.familyId)
        && (resource.data.userId == uid() || isAdminOf(resource.data.familyId));
    }

    // ---------- budgets ----------
    match /budgets/{budgetId} {
      allow read: if isMemberOf(resource.data.familyId);

      allow create: if isAdminOf(request.resource.data.familyId)
        && request.resource.data.categoryId is string
        && request.resource.data.monthlyLimit is number
        && request.resource.data.monthlyLimit >= 0;

      allow update: if isAdminOf(resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.monthlyLimit >= 0;

      allow delete: if isAdminOf(resource.data.familyId);
    }
  }
}
